{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (data.child('roomId').isString() && (root.child('rooms').child(data.child('roomId').val()).child('a').val() === auth.uid || root.child('rooms').child(data.child('roomId').val()).child('b').val() === auth.uid || !root.child('rooms').child(data.child('roomId').val()).child('b').exists())))",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        }
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && root.child('rooms').child(newData.val()).child('a').val() === auth.uid) || (!newData.exists() && (root.child('rooms').child(data.val()).child('a').val() === auth.uid || root.child('rooms').child(data.val()).child('b').val() === auth.uid)))"
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$rid": {
        ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid || !data.child('b').exists())",
        ".write": "auth != null && !newData.exists() && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        "a": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "b": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('a').val() !== auth.uid"
        },
        "info": {
          ".write": "auth != null && (newData.parent().child('a').val() === auth.uid || newData.parent().child('b').val() === auth.uid)"
        }
      }
    },
    "live": {
      "$rid": {
        ".read": "auth != null && (root.child('rooms').child($rid).child('a').val() === auth.uid || root.child('rooms').child($rid).child('b').val() === auth.uid)",
        ".write": "auth != null && (root.child('rooms').child($rid).child('a').val() === auth.uid || root.child('rooms').child($rid).child('b').val() === auth.uid)",
        "chat": {
          "$id": {
            ".validate": "!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 300)"
          }
        },
        "diary": {
          "$id": {
            ".validate": "!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 2000)"
          }
        },
        "surprise": {
          "$id": {
            ".validate": "!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 4000)"
          }
        },
        "frames": {
          "$f": {
            ".validate": "!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 1500000)"
          }
        },
        "album": {
          "$id": {
            ".validate": "!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 1500000)"
          }
        },
        "booth": {
          "slots": {
            "$uid": {
              ".validate": "newData.isString() && newData.val().length <= 1500000"
            }
          }
        }
      }
    },
    "showcase": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('showcaseRid').child($id).exists() && (root.child('rooms').child(root.child('showcaseRid').child($id).val()).child('a').val() === auth.uid || root.child('rooms').child(root.child('showcaseRid').child($id).val()).child('b').val() === auth.uid)"
      }
    },
    "showcaseRid": {
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.isString() && (root.child('rooms').child(newData.val()).child('a').val() === auth.uid || root.child('rooms').child(newData.val()).child('b').val() === auth.uid)) || (data.exists() && !newData.exists() && (root.child('rooms').child(data.val()).child('a').val() === auth.uid || root.child('rooms').child(data.val()).child('b').val() === auth.uid)))"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !newData.exists()"
      }
    },
    "metrics": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "active": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "online": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "admin": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false
    }
  }
}
