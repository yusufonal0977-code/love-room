{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && root.child('rooms').child(newData.val()).child('a').val() === auth.uid) || (!newData.exists() && (root.child('rooms').child(data.val()).child('a').val() === auth.uid || root.child('rooms').child(data.val()).child('b').val() === auth.uid)))"
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$rid": {
        ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid || !data.child('b').exists())",
        ".write": "auth != null && !newData.exists() && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        "a": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "b": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('a').val() !== auth.uid"
        },
        "info": {
          ".write": "auth != null && (newData.parent().child('a').val() === auth.uid || newData.parent().child('b').val() === auth.uid)"
        }
      }
    },
    "live": {
      "$rid": {
        ".read": "auth != null && (root.child('rooms').child($rid).child('a').val() === auth.uid || root.child('rooms').child($rid).child('b').val() === auth.uid)",
        ".write": "auth != null && (root.child('rooms').child($rid).child('a').val() === auth.uid || root.child('rooms').child($rid).child('b').val() === auth.uid)"
      }
    },
    "showcase": {
      "$id": {
        ".read": true,
        ".write": "auth != null && ((newData.exists() && (root.child('rooms').child(newData.child('rid').val()).child('a').val() === auth.uid || root.child('rooms').child(newData.child('rid').val()).child('b').val() === auth.uid) && (!data.exists() || data.child('rid').val() === newData.child('rid').val())) || (!newData.exists() && (root.child('rooms').child(data.child('rid').val()).child('a').val() === auth.uid || root.child('rooms').child(data.child('rid').val()).child('b').val() === auth.uid)))"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.val() === '__ADMIN_SIFRE__'"
      }
    },
    "metrics": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "active": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      },
      "online": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "admin": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "presence": {
        "$uid": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists() && auth.uid === $uid"
        }
      },
      "coins": {
        "$uid": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists() && auth.uid === $uid"
        }
      },
      "roulette": {
        "bets": {
          "$round": {
            "$uid": {
              ".write": "auth != null && root.child('admins').child(auth.uid).exists() && auth.uid === $uid"
            }
          }
        },
        "results": {
          "$round": {
            ".write": "auth != null && root.child('admins').child(auth.uid).exists() && !data.exists() && newData.isNumber() && newData.val() >= 0 && newData.val() <= 36"
          }
        }
      },
      "config": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      },
      "matches": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    }
  }
}
