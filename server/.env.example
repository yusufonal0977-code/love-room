# Bu dosyayı ".env" adıyla kopyalayın ve doldurun.

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Mobil uygulama için iOS/Android client id'leri (virgülle)
GOOGLE_EXTRA_AUDIENCES=

# Sadece isimle giriş (geliştirme). Google ayarlıysa varsayılan kapalı; test için 1 yapabilirsiniz.
# DEV_LOGIN=1

# PORT=4000
# CORS_ORIGIN=https://loveroom.example.com
# AUTH_SECRET=uzun-rastgele-bir-deger
