<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/widget_bg" android:padding="10dp" android:gravity="center_vertical">
  <ImageView android:id="@+id/petImg" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
      android:scaleType="fitCenter" android:contentDescription="@string/w_pet" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical" android:paddingStart="8dp">
    <TextView android:id="@+id/petName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/petHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/signin_hint" android:textColor="@color/soft" android:textSize="10sp" android:visibility="gone" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/food" android:textColor="@color/soft" android:textSize="10sp" android:paddingTop="4dp" />
    <ProgressBar android:id="@+id/barFood" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/love" android:textColor="@color/soft" android:textSize="10sp" android:paddingTop="3dp" />
    <ProgressBar android:id="@+id/barLove" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/play" android:textColor="@color/soft" android:textSize="10sp" android:paddingTop="3dp" />
    <ProgressBar android:id="@+id/barPlay" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/bar" />
  </LinearLayout>
</LinearLayout>
