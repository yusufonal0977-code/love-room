<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:background="@drawable/widget_bg" android:padding="12dp" android:gravity="center_vertical">
  <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/record" android:contentDescription="@string/w_music" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/w_music" android:textColor="@color/sun" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/musicTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/musicSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/soft" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
</LinearLayout>
