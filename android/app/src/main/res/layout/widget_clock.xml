<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="10dp" android:gravity="center">
  <TextView android:id="@+id/clockBig" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="@color/sun" android:textSize="40sp" android:textStyle="bold" />
  <TextView android:id="@+id/clockSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="@color/ink" android:textSize="12sp" android:gravity="center" />
  <TextView android:id="@+id/clockMeet" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="#ff8fab" android:textSize="11sp" android:paddingTop="4dp" android:visibility="gone" />
</LinearLayout>
